<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.key.controller.EditorialFXController">
    <padding><Insets top="20" right="20" bottom="20" left="20" /></padding>

    <left>
        <VBox spacing="10" minWidth="300" maxWidth="300">
            <padding><Insets right="20" /></padding>
            <Label text="Registrar Editorial" style="-fx-font-size: 18; -fx-font-weight: bold;" />
            
            <!-- AQUÍ ESTABA EL ERROR: Cambié txtNit por txtNitEditorial -->
            <TextField fx:id="txtNitEditorial" promptText="NIT" />
            
            <TextField fx:id="txtNombreEditorial" promptText="Nombre Editorial" />
            <TextField fx:id="txtTelefonoEditorial" promptText="Telefono Editorial" />
            <TextField fx:id="txtDireccionEditorial" promptText="Direccion Editorial" />
            <HBox spacing="10">
                <Button text="Guardar" onAction="#handleGuardar" prefWidth="120" />
                <Button text="Limpiar" onAction="#handleLimpiar" prefWidth="120" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label text="Lista de Editoriales" style="-fx-font-size: 18; -fx-font-weight: bold;" />
            <TableView fx:id="tablaEditorial">
                <columns>
                    <TableColumn text="NIT" prefWidth="120">
                        <cellValueFactory>
                            <PropertyValueFactory property="nit" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Nombre Editorial" prefWidth="140">
                        <cellValueFactory>
                            <PropertyValueFactory property="nombreEditorial" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Telefono Editorial" prefWidth="140">
                        <cellValueFactory>
                            <PropertyValueFactory property="telefonoEditorial" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Direccion Editorial" prefWidth="200">
                        <cellValueFactory>
                            <PropertyValueFactory property="direccionEditorial" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button text="Actualizar Tabla" onAction="#handleActualizar" />
                <Button text="Volver al Menú" onAction="#handleVolver" />
            </HBox>
        </VBox>
    </center>
</BorderPane>