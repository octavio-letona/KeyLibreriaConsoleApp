<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@editorialview.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.key.controller.EditorialFXController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <!-- NUEVA SECCIÓN: Barra de búsqueda superior -->
    <top>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <padding><Insets bottom="20" /></padding>
            <Label style="-fx-font-size: 14; -fx-font-weight: bold;" text="Buscar Editorial:" />
            <TextField fx:id="txtBuscar" promptText="Ingrese búsqueda..." prefWidth="250" />
            <Button onAction="#handleBuscar" text="Buscar" />
        </HBox>
    </top>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding><Insets right="20" /></padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Registrar Editorial" />
            
            <!-- AQUÍ ESTABA EL ERROR: Cambié txtNit por txtNitEditorial -->
            <TextField fx:id="txtNitEditorial" promptText="NIT" />
            
            <TextField fx:id="txtNombreEditorial" promptText="Nombre Editorial" />
            <TextField fx:id="txtTelefonoEditorial" promptText="Telefono Editorial" />
            <TextField fx:id="txtDireccionEditorial" promptText="Direccion Editorial" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Editoriales" />
            <TableView fx:id="tablaEditorial" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colNit" prefWidth="120" text="NIT">
                        <cellValueFactory>
                            <PropertyValueFactory property="nit" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colNombre" prefWidth="140" text="Nombre Editorial">
                        <cellValueFactory>
                            <PropertyValueFactory property="nombreEditorial" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colTelefono" prefWidth="140" text="Telefono Editorial">
                        <cellValueFactory>
                            <PropertyValueFactory property="telefonoEditorial" />
                        </cellValueFactory>
                    </TableColumn>
                    <TableColumn fx:id="colDirecion" prefWidth="200" text="Direccion Editorial">
                        <cellValueFactory>
                            <PropertyValueFactory property="direccionEditorial" />
                        </cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#handleActualizar" text="Actualizar Tabla" />
                <Button onAction="#handleVolver" text="Volver al Menú" />
            </HBox>
        </VBox>
    </center>
</BorderPane>