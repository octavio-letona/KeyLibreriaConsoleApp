<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.cell.PropertyValueFactory?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.key.controller.AutorviewController">
    <top>
        <Label text="Módulo de Autores" style="-fx-font-size: 24; -fx-font-weight: bold;" BorderPane.alignment="CENTER">
            <padding><Insets top="20" bottom="20"/></padding>
        </Label>
    </top>
    <left>
        <VBox spacing="15">
            <padding><Insets top="10" right="20" bottom="10" left="20" /></padding>
            <GridPane hgap="10" vgap="10">
                <Label text="ID Autor:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                <TextField fx:id="txtIdAutor" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                
                <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                <TextField fx:id="txtNombreAutor" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                
                <Label text="Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                <TextField fx:id="txtApellidoAutor" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                
                <Label text="Nacionalidad:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                <TextField fx:id="txtNacionalidad" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

                <Label text="Biografía:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
                <TextField fx:id="txtBiografia" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
            </GridPane>
            
            <Label fx:id="lblMensaje" textFill="red" />
            
            <HBox spacing="10">
                <Button text="Guardar" onAction="#handleGuardar" />
                <Button text="Limpiar" onAction="#handleLimpiar" />
            </HBox>
            
            <Button text="Volver al Menú" onAction="#handleVolver" />
        </VBox>
    </left>
    <center>
        <VBox spacing="10">
            <padding><Insets top="10" right="20" bottom="20" left="10" /></padding>
            <TableView fx:id="tablaAutores" prefHeight="400" prefWidth="600">
                <columns>
                    <TableColumn text="ID Autor" prefWidth="60">
                        <cellValueFactory><PropertyValueFactory property="idAutor" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Nombre" prefWidth="110">
                        <cellValueFactory><PropertyValueFactory property="nombreAutor" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Apellido" prefWidth="110">
                        <cellValueFactory><PropertyValueFactory property="apellidoAutor" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Nacionalidad" prefWidth="110">
                        <cellValueFactory><PropertyValueFactory property="nacionalidad" /></cellValueFactory>
                    </TableColumn>
                    <TableColumn text="Biografía" prefWidth="210">
                        <cellValueFactory><PropertyValueFactory property="biografia" /></cellValueFactory>
                    </TableColumn>
                </columns>
            </TableView>
            <Button text="Actualizar Lista" onAction="#handleActualizar" />
        </VBox>
    </center>
</BorderPane>