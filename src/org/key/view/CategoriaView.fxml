<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@categoriaview.css" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.key.controller.CategoriaController">
    <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>

    <left>
        <VBox maxWidth="300" minWidth="300" spacing="10">
            <padding><Insets right="20" /></padding>
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Gestión de Categorías" />
            <TextField fx:id="txtID_categoria" editable="false" promptText="ID (Autogenerado)" />
            <TextField fx:id="txtNombre_categoria" promptText="Nombre de Categoría" />
            <HBox spacing="10">
                <Button onAction="#handleGuardar" prefWidth="120" text="Guardar" />
                <Button onAction="#handleActualizar" prefWidth="120" text="Actualizar" />
            </HBox>
            <HBox spacing="10">
                <Button onAction="#handleEliminar" prefWidth="120" text="Eliminar" />
                <Button onAction="#handleLimpiar" prefWidth="120" text="Limpiar" />
            </HBox>
            <Label fx:id="lblMensaje" />
        </VBox>
    </left>

    <center>
        <VBox spacing="10">
            <Label style="-fx-font-size: 18; -fx-font-weight: bold;" text="Lista de Categorías" />
            <TableView fx:id="tablaCategoria">
                <columns>
                    <TableColumn fx:id="colID" prefWidth="100" text="ID" />

                    <TableColumn fx:id="colNombre" prefWidth="300" text="Nombre de Categoría" />
                </columns>
            </TableView>
            <HBox spacing="10">
                <Button onAction="#handleVolver" text="Volver al Menú" />
            </HBox>
        </VBox>
    </center>
</BorderPane>
