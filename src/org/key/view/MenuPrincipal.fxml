<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.key.controller.MenuPrincipalController">
    <top>
        <Label text="Key Librería - Menú Principal" style="-fx-font-size: 24; -fx-font-weight: bold;" BorderPane.alignment="CENTER">
            <padding><Insets top="20" /></padding>
        </Label>
    </top>
    <center>
        <VBox spacing="15" alignment="CENTER">
            <padding><Insets top="30" right="40" bottom="30" left="40" /></padding>
            <Button text="Clientes" prefWidth="220" prefHeight="40" onAction="#handleClientes" />
            <Button text="Autores" prefWidth="220" prefHeight="40" onAction="#handleNoDisponible" />
            <Button text="Categorías" prefWidth="220" prefHeight="40" onAction="#handleNoDisponible" />
            <Button text="Editoriales" prefWidth="220" prefHeight="40" onAction="#handleNoDisponible" />
            <Button text="Salir" prefWidth="220" prefHeight="40" onAction="#handleSalir" />
        </VBox>
    </center>
</BorderPane>